# Copy to .env (git-ignored) and adjust. All values are optional.
# Path of the SQLite database. Defaults to instance/noor.db locally and /tmp/noor.db on Vercel.
NOOR_DB_PATH=
# Secret used to sign the session cookie (only used for flash messages). Set a long random value in production.
NOOR_SECRET_KEY=
# Maximum upload size in bytes for CSV imports (default 2000000).
NOOR_MAX_UPLOAD_BYTES=
# Set to 1 to allow the Open-Meteo fetch endpoint/command to call the network (default off on Vercel, on locally via CLI only).
NOOR_ENABLE_OPEN_METEO=
